#!/system/bin/sh

TOKEN_FILE="/storage/emulated/0/Android/data/com.termux/files/.stellar-stsh-token"
PYTHON="${PREFIX:-/data/data/com.termux/files/usr}/bin/python"

# Run a command directly by default. Use `-c` for shell syntax such as pipes,
# variables, and command chaining; keep `exec` as an explicit alias.
case "${1:-}" in
    ""|exec|-*) ;;
    --)
        shift
        set -- exec "$@"
        ;;
    *)
        set -- exec "$@"
        ;;
esac

if [ -x "$PYTHON" ] && [ -r "$TOKEN_FILE" ]; then
    exec "$PYTHON" - "$@" <<'PY'
import base64
import socket
import sys

TOKEN_FILE = "/storage/emulated/0/Android/data/com.termux/files/.stellar-stsh-token"

try:
    with open(TOKEN_FILE, "r", encoding="utf-8") as token_file:
        token = token_file.read().strip()
    payload = "\n".join([
        "STSH1",
        token,
        *(base64.b64encode(argument.encode()).decode() for argument in sys.argv[1:]),
        "",
    ]).encode()

    with socket.create_connection(("127.0.0.1", 59521), timeout=3) as client:
        client.settimeout(None)
        client.sendall(payload)
        client.shutdown(socket.SHUT_WR)
        response = bytearray()
        while True:
            chunk = client.recv(8192)
            if not chunk:
                break
            response.extend(chunk)
except Exception as error:
    print(f"Stellar stsh bridge unavailable: {error}", file=sys.stderr)
    sys.exit(125)

status_line, separator, body = bytes(response).partition(b"\n")
if not separator or not status_line.startswith(b"STSH_STATUS="):
    print("Invalid response from Stellar stsh bridge", file=sys.stderr)
    sys.exit(125)

sys.stdout.buffer.write(body)
sys.stdout.buffer.flush()
try:
    sys.exit(int(status_line.removeprefix(b"STSH_STATUS=")))
except ValueError:
    sys.exit(125)
PY
fi

MANAGER_PACKAGE="${STSH_MANAGER_APPLICATION_ID:-roro.stellar.manager}"
APK="$(/system/bin/pm path "$MANAGER_PACKAGE" 2>/dev/null \
    | /system/bin/sed -n '1s/^package://p')"

if [ -z "$APK" ] || [ ! -r "$APK" ]; then
    echo "Stellar APK not found for $MANAGER_PACKAGE" >&2
    exit 1
fi

export CLASSPATH="$APK"
export STSH_APPLICATION_ID="${STSH_APPLICATION_ID:-com.termux}"

exec /system/bin/app_process /system/bin \
    --nice-name=stsh \
    roro.stellar.manager.shell.StellarShellLoader "$@"
