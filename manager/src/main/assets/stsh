#!/system/bin/sh

DEX_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DEX="$DEX_DIR/stsh_stellar.dex"

if [ ! -f "$DEX" ]; then
    echo "stsh_stellar.dex not found; copy the exported stsh files together" >&2
    exit 1
fi

chmod 400 "$DEX" 2>/dev/null
export CLASSPATH="$DEX"
export STSH_APPLICATION_ID="${STSH_APPLICATION_ID:-com.termux}"

exec /system/bin/app_process /system/bin \
    --nice-name=stsh \
    roro.stellar.shell.StellarShellLoader "$@"
