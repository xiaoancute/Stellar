#!/system/bin/sh

MANAGER_PACKAGE="${STSH_MANAGER_APPLICATION_ID:-roro.stellar.manager}"
APK="$(/system/bin/pm path "$MANAGER_PACKAGE" 2>/dev/null \
    | /system/bin/sed -n '1s/^package://p')"

if [ -z "$APK" ] || [ ! -r "$APK" ]; then
    echo "Stellar APK not found for $MANAGER_PACKAGE" >&2
    exit 1
fi

export CLASSPATH="$APK"
export STSH_APPLICATION_ID="${STSH_APPLICATION_ID:-com.termux}"

exec /system/bin/app_process /system/bin \
    --nice-name=stsh \
    roro.stellar.manager.shell.StellarShellLoader "$@"
